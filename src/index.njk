{# 88x31 buttons. The lists come from src/_data/buttons.js — add one there, not
   here. Every button carries explicit width and height so the wall doesn't
   reflow as the GIFs arrive, and loading="lazy" because this is the last thing
   on the page and none of it is worth delaying the text above it. #}
{% macro wall(items, empty) %}
  {% if items.length %}
  <ul class="button-wall">
    {% for button in items %}
    <li>
      {% if button.href %}
      <a href="{{ button.href }}" rel="noopener">
        <img src="/buttons/{{ button.file }}" width="88" height="31" alt="{{ button.alt }}" loading="lazy">
      </a>
      {% else %}
      <img src="/buttons/{{ button.file }}" width="88" height="31" alt="{{ button.alt }}" loading="lazy">
      {% endif %}
      {% if button.note %}<span class="button-note">{{ button.note }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="wall-empty">{{ empty }}</p>
  {% endif %}
{% endmacro %}

<div class="panel" id="buttons">
  <h2>buttons</h2>
  <p class="prompt">eighty-eight by thirty-one pixels, the old web's unit of
    saying hello. no ring, no ranking, no javascript counting the clicks —
    just links, kept by hand.</p>

  <h3 class="wall-head">link here</h3>
  {{ wall(buttons.mine) }}
  <p>if you want to link to this node, please do — no permission needed, no
    reciprocal link expected, nothing to join. take the animated one, or the
    still one if your page is somewhere motion isn't welcome.</p>

  <ol class="steps">
    <li><strong>download the gif.</strong> right-click and save it, or
      <code>curl -O {{ buttons.origin }}/buttons/{{ buttons.hero }}</code></li>
    <li><strong>upload it to your own site</strong>, wherever you keep
      images.</li>
    <li><strong>paste this</strong>, with <code>src</code> pointing at your
      copy — not at mine:</li>
  </ol>
  <pre class="embed"><code>{{ buttons.embed }}</code></pre>

  <p>that third step is the one people skip, so: <strong>please don't hotlink
    it.</strong> pointing <code>src</code> back here means every visitor to
    your page fetches the button off my server — it spends my bandwidth to
    render your site, it breaks the day i reorganise a directory, and it hands
    me a log line for every one of your readers, which is nobody's business but
    theirs. an 88x31 is under 18 kilobytes. keep your own copy; that's the
    whole etiquette of the form.</p>

  <h3 class="wall-head">badges</h3>
  {{ wall(buttons.badges) }}
  <p>these don't link anywhere. take them if you mean them.</p>

  <h3 class="wall-head">friends of the node</h3>
  {{ wall(buttons.friends, "// nobody on file yet. if we've spoken, send me yours.") }}

  <h3 class="wall-head">found in the wild</h3>
  {{ wall(buttons.collected, "// nothing on file yet.") }}
</div>
